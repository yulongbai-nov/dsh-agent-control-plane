index 00000000..e7f88b3a
--- /dev/null
+++ b/packages/api/session-controller/src/catalog-access.ts
@@ -0,0 +1,48 @@
+/** WIP: scope parent-owned subagent catalog metadata for non-owner Remote calls.
+ * This covers only `subagentCatalog` and `subagent/catalog`, not other event
+ * types, plugin-defined projections, access-revocation cache invalidation, or
+ * arbitrary child identifiers inside message bodies. Not an installation-ready
+ * authorization boundary. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import { principalOf, RemoteError } from '@deepseek-ai/dsh-typert-protocol'
+import type { SessionHistoryRecord, SessionProjectionValues, SessionWireEvent } from './types.ts'
+
+function denied(ctx: Context): never {
+  const request=ctx.invocation?.request
+  throw new RemoteError('remote-access/denied', 'subagent catalog child is not available', {
+    action: request === undefined ? 'session/unknown' : `${request.namespace}/${request.method}`,
+    reason: 'catalog-child-denied',
+  })
+}
+
+function childAllowed(ctx: Context, value: unknown): boolean {
+  if (typeof value !== 'string' || value.length === 0) return false
+  return ctx.remoteAccess.allows({kind:'session',id:value as SessionId})
+}
+
+export function filterCatalog(ctx: Context, values: SessionProjectionValues): SessionProjectionValues {
+  // Owner and trusted in-process callers keep the existing unfiltered behavior.
+  if (principalOf(ctx.invocation) === undefined) return values
+  const catalog=(values as Record<string, unknown>).subagentCatalog
+  if (catalog === undefined) return values
+  if (!Array.isArray(catalog)) return denied(ctx)
+  const visible: unknown[]=[]
+  for(const entry of catalog) {
+    if (entry === null || typeof entry !== 'object' || Array.isArray(entry)) return denied(ctx)
+    const id=(entry as Record<string,unknown>).id
+    if (typeof id !== 'string' || id.length === 0) return denied(ctx)
+    if (childAllowed(ctx,id)) visible.push(entry)
+  }
+  return {...values,subagentCatalog:visible} as SessionProjectionValues
+}
+
+export function assertCatalogEventAccess(ctx: Context, event: SessionWireEvent): void {
+  if (principalOf(ctx.invocation) === undefined || event.type !== 'subagent/catalog') return
+  const data=event.data
+  if (data === null || typeof data !== 'object' || Array.isArray(data) || !childAllowed(ctx,(data as Record<string,unknown>).childId)) denied(ctx)
+}
+
+export function assertCatalogRecordsAccess(ctx: Context, records: readonly SessionHistoryRecord[]): void {
+  for(const record of records) assertCatalogEventAccess(ctx,record.event)
+}
diff --git a/packages/api/session-controller/tests/r7-synthetic-catalog-mitigation.host.spec.ts b/packages/api/session-controller/tests/r7-synthetic-catalog-mitigation.host.spec.ts
