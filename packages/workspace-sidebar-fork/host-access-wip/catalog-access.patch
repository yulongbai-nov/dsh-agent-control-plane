+import { describe, expect, it } from 'vitest'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { SessionManager } from '../src/client/sessions/manager.ts'
+const parent='synthetic-parent' as SessionId, removed='synthetic-removed' as SessionId
+
+describe('WIP access reset',()=>{
+ it('clears omitted projections and replaces a catalog at an unchanged source sequence',async()=>{
+  const manager=new SessionManager({} as never)
+  try {
+   manager.handleControlFrame({type:'baseline',value:{projections:{
+    [parent]:{asOfSeq:4,values:{subagentCatalog:[{id:'synthetic-child',mode:'one-shot'}]}},
+    [removed]:{asOfSeq:4,values:{title:'synthetic-private'}}
+   }}} as never)
+   expect(manager.projectionValues(parent)?.subagentCatalog).toHaveLength(1)
+   manager.handleControlFrame({type:'access-reset',value:{projections:{[parent]:{asOfSeq:4,values:{subagentCatalog:[]}}}}} as never)
+   expect(manager.projectionValues(parent)?.subagentCatalog).toEqual([])
+   expect(manager.projectionValues(removed)).toEqual({})
+  } finally {await manager.dispose()}
+ })
+ it('aborts an in-flight projection response so it cannot reinsert stale catalog',async()=>{
+  let resolve!: (value:unknown)=>void
+  const remote={session:{projections:()=>new Promise(done=>{resolve=done})}}
+  const manager=new SessionManager(remote as never)
+  try {
+   const pending=manager.refreshProjections(parent)
+   manager.handleControlFrame({type:'access-reset',value:{projections:{[parent]:{asOfSeq:4,values:{subagentCatalog:[]}}}}} as never)
+   resolve({ok:true,value:{kind:'sequenced',asOfSeq:4,values:{subagentCatalog:[{id:'synthetic-child',mode:'one-shot'}]}}})
+   await pending
+   expect(manager.projectionValues(parent)?.subagentCatalog).toEqual([])
+  } finally {await manager.dispose()}
+ })
+})
+
+describe('WIP control protocol compatibility',()=>{
+ it('new client does not silently fall back when old Host lacks controlV2',async()=>{
+  const {createSessionControlStream}=await import('../src/client/transport.ts')
+  let open: ((signal:AbortSignal)=>unknown) | undefined, legacyCalls=0
+  const remote={
+   session:{control(){legacyCalls++}},
+   $stream(options:{open:(signal:AbortSignal)=>unknown}){open=options.open;return {}}
+  }
+  createSessionControlStream(remote as never,{accept(){},failed(){}})
+  expect(open).toBeTypeOf('function')
+  expect(()=>open?.(new AbortController().signal)).toThrow()
+  expect(legacyCalls).toBe(0)
+ })
+})
