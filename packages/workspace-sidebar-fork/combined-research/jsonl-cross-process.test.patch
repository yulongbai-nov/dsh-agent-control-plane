+/** Isolated child worker used only when the synthetic parent supplies a root. */
+import { access, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { setTimeout as delay } from 'node:timers/promises'
+import { Context } from '@deepseek-ai/cordis'
+import { SessionId, SESSION_FORMAT_VERSION } from '@deepseek-ai/dsh-session'
+import { it } from 'vitest'
+import * as JsonlSessionPersistence from '../src/index.ts'
+const root = process.env.R7_SYNTHETIC_ROOT
+it.skipIf(root === undefined)('publishes a pending JSONL session only after the parent barrier', async () => {
+  if (root === undefined) throw Error('missing synthetic root')
+  const ctx = new Context()
+  try {
+    await ctx.plugin(JsonlSessionPersistence, { root: join(root, 'store'), compression: 'none' })
+    const handle = await ctx.sessionPersistence.create({ version: SESSION_FORMAT_VERSION, id: SessionId('synthetic-child'), createdAt: 1, cwd: '/synthetic', isSeeded: false })
+    const own = (await ctx.sessionPersistence.list()).map(item => item.header.id).sort()
+    await writeFile(join(root, 'pending'), JSON.stringify(own))
+    let released = false
+    for (let i = 0; i < 500; i++) { try { await access(join(root, 'release')); released = true; break } catch { await delay(20) } }
+    if (!released) throw Error('parent barrier timed out')
+    await handle.flush()
+    await writeFile(join(root, 'flushed'), 'ready')
+    await handle.close()
+  } finally { await ctx.fiber.dispose() }
+}, 15000)
