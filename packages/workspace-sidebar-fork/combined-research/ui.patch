+   const reset=await Promise.race([h.stream.next(),new Promise<'timeout'>(resolve=>setTimeout(()=>resolve('timeout'),1000))]);if(reset==='timeout'||reset.done||reset.value.type!=='access-reset')throw Error('missing access reset')
+   sessions.handleControlFrame(reset.value)
+   expect(sessions.binding(child)).toBeUndefined()
+   expect(notices).toContainEqual({kind:'accessChanged'})
+   expect(layout.selectPanel).toHaveBeenCalledWith(null)
