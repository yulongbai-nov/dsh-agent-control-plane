+  /** Monotone count of access resets in this Client instance, omitted before the first. */
+  accessResetRevision?: number
@@ -249,0 +252 @@ export class ClientSessions implements ISessions {
+  private accessResetRevision = 0
@@ -379,0 +383,17 @@ export class ClientSessions implements ISessions {
+    if (frame.type !== 'access-reset') return
+    this.accessResetRevision++
+    // No access-reset frame carries a complete list or an authorization proof
+    // for previously retained scopes. Withdraw all prior-generation references
+    // synchronously; callers can reopen allowed sessions after the fresh list.
+    const scopes = [...this.scopes]
+    this.scopes.clear()
+    for (const [id, record] of scopes) {
+      record.live = false
+      record.session.unbindScope()
+      this.startScopeDrop(id, record)
+    }
+    this.projectList()
+    for (const [id] of scopes) this.publishRetention(id)
+    // The old list pull is fenced in SessionManager; obtain a new one without
+    // exposing the old metadata while the request is pending or has failed.
+    void this.manager.refreshList().catch(() => {})
@@ -691 +711,2 @@ export class ClientSessions implements ISessions {
-    this.list.set({ ids, byId, phase, projectionsBySession })
+    this.list.set({ ids, byId, phase, projectionsBySession,
+      ...(this.accessResetRevision === 0 ? {} : { accessResetRevision: this.accessResetRevision }) })
