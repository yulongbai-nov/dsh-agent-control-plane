diff --git a/packages/api/session-controller/src/client/sessions/manager.ts b/packages/api/session-controller/src/client/sessions/manager.ts
index b8bec9be..4a35a6c5 100644
--- a/packages/api/session-controller/src/client/sessions/manager.ts
+++ b/packages/api/session-controller/src/client/sessions/manager.ts
@@ -648,0 +649,23 @@ export class SessionManager {
+    if (frame.type === 'access-reset') {
+      // Access changes are not Session events: reset existing values and cuts
+      // rather than fabricating a higher seq, and fence outstanding reads.
+      // Session list replies have no cancellation parameter; invalidate their
+      // mutation token so an old principal's response cannot repopulate rows.
+      this.listMutations = null
+      this.listInflight = null
+      this.summaries = []
+      this.listPhase = 'pending'
+      this.listState = 'idle'
+      this.listError = null
+      this.engagedSessions.clear()
+      this.addresses.clear()
+      this.entryCache.clear()
+      this.itemsCache = []
+      for (const { controller } of this.projectionInflight.values()) controller.abort()
+      this.projectionInflight.clear()
+      this.projectionLoads.clear()
+      for (const store of this.projectionStores.values()) store.clear()
+      this.projectionStores.clear()
+      this.replaceControlBaseline(frame.value)
+      return
+    }
