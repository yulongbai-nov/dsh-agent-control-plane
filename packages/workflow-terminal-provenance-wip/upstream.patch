+  /**
+   * WIP observer for process-local terminal dispatch. Observations contain no
+   * arguments and make no source, authorization, durability or accepted-init
+   * claim. Only trusted synchronous observers may subscribe; they must not
+   * reenter the runtime and must own any asynchronous error handling.
+   */
+  observeTerminalAttempts(observer: (observation: TerminalAttemptObservation) => void): () => void {
+    if (typeof observer !== 'function') throw new TypeError('terminal observer must be a function')
+    const observers = this.terminalObservers
+    // Each registration owns its own entry even when callbacks are identical.
+    const entry = (observation: TerminalAttemptObservation): void => { observer(observation) }
+    return this.ctx.effect(() => {
+      observers.add(entry)
+      return () => { observers.delete(entry) }
+    }, 'tools.observeTerminalAttempts()')
+  }
