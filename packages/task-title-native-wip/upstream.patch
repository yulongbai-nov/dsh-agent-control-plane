@@ -70,0 +74,27 @@ declare module '@deepseek-ai/cordis' {
+/** Experimental live-source facts. This is not an authorization token. */
+export interface TaskTitleCandidate {
+  readonly leadId: string
+  readonly taskId: string
+  readonly taskRevision: number
+  readonly taskEventSeq: number
+  readonly title: string
+}
+/** A host-owned synchronous verifier; an arbitrary plugin is not a trust boundary. */
+export interface TaskTitleAuthority {
+  verify(session: Session, candidate: TaskTitleCandidate): boolean
+}
+
+/** Fixed primitive snapshot: reject accessors and proxies before invocation. */
+function snapshotTaskCandidate(input: TaskTitleCandidate): TaskTitleCandidate {
+  if (input === null || typeof input !== 'object' || nodeTypes.isProxy(input) ||
+    ![Object.prototype, null].includes(Object.getPrototypeOf(input)) || Object.getOwnPropertySymbols(input).length) throw new Error('invalid task title candidate')
+  const fields = Object.getOwnPropertyDescriptors(input)
+  const keys = ['leadId', 'taskId', 'taskRevision', 'taskEventSeq', 'title']
+  if (Object.keys(fields).length !== keys.length || keys.some(key => !Object.hasOwn(fields, key)) ||
+    Object.values(fields).some(field => !('value' in field))) throw new Error('invalid task title candidate')
+  const {leadId, taskId, taskRevision, taskEventSeq, title} = Object.fromEntries(keys.map(key => [key, fields[key]!.value]))
+  if (typeof leadId !== 'string' || !leadId || leadId.length > 200 || typeof taskId !== 'string' || !taskId || taskId.length > 200 ||
+    !Number.isSafeInteger(taskRevision) || taskRevision < 1 || !Number.isSafeInteger(taskEventSeq) || taskEventSeq < 0 || typeof title !== 'string' || title.length > 4096) throw new Error('invalid task title candidate')
+  return Object.freeze({leadId,taskId,taskRevision,taskEventSeq,title}) as TaskTitleCandidate
+}
+
@@ -150,0 +181 @@ function copySessionTitleSource(source: SessionTitleSource): SessionTitleSource
+    case 'task': return { ...source }
@@ -395,0 +427,34 @@ export class SessionTitleService extends Service {
+  /**
+   * Experimental synchronous acceptance seam only: the host must observe task
+   * changes and provide a trusted authority. Not safe for a deployed profile.
+   */
+  submitTaskTitle(session: Session, input: TaskTitleCandidate, signal?: AbortSignal): SessionTitleSnapshot | undefined {
+    signal?.throwIfAborted()
+    this.assertServiceActive()
+    if (this.ctx.sessions.get(session.id) !== session) throw new Error('task title session is not live')
+    const candidate = snapshotTaskCandidate(input)
+    const title = normalizeSessionTitle(candidate.title, this.config.maxTitleBytes)
+    if (!title) throw new SessionTitleInvalidError('task title must contain visible characters')
+    const authority = this.ctx.get('taskTitleAuthority')
+    if (!authority || authority.verify(session, candidate) !== true) return undefined
+    if (this.get(session)?.source.kind === 'user') return undefined
+    // Use the child's own title events as a replayable watermark for this lead.
+    // oxlint-disable-next-line typescript/no-deprecated -- Experimental replay check.
+    for (const event of session.snapshotEvents()) {
+      if (event.type === 'session/title' && event.data.source.kind === 'task' && event.data.source.leadId === candidate.leadId && event.data.source.taskEventSeq >= candidate.taskEventSeq) return undefined
+    }
+    const state = this.stateFor(session)
+    const revision = this.supersede(state, 'task title superseded older automatic generation')
+    signal?.throwIfAborted()
+    if (!this.serviceActive() || this.ctx.sessions.get(session.id) !== session || state.revision !== revision ||
+      this.get(session)?.source.kind === 'user' || this.ctx.get('taskTitleAuthority') !== authority || authority.verify(session, candidate) !== true) return undefined
+    // A verifier or abort handler can synchronously reenter the service.
+    signal?.throwIfAborted()
+    if (!this.serviceActive() || this.ctx.sessions.get(session.id) !== session || state.revision !== revision || this.get(session)?.source.kind === 'user') return undefined
+    session.append('session/title', { title, messageSeqs: [], source: {
+      kind: 'task', leadId: candidate.leadId, taskId: candidate.taskId,
+      taskRevision: candidate.taskRevision, taskEventSeq: candidate.taskEventSeq,
+    } })
+    return this.get(session)
+  }
+
