+++ b/packages/session/session-title/tests/task-wip.spec.ts
@@ -0,0 +1,138 @@
+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it, vi } from 'vitest'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import SessionStore, { SessionId, appendPluginRecord, pluginRecordOf } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import SessionTitleService, { SessionTitleProviderId, foldSessionTitle } from '../src/index.ts'
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface PluginRecordMap {
+    'plugin:test-task-title': {version:number; title:string}
+  }
+}
+
+const CONFIG = { fallbackMaxWords: 5, fallbackMaxBytes: 40, maxTitleBytes: 40 }
+const candidate = (seq: number, title = 'Synthetic task') => ({ leadId:'lead', taskId:'task', taskRevision:seq, taskEventSeq:seq, title })
+async function setup() {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  const fiber = await ctx.plugin(SessionTitleService, CONFIG)
+  const session = ctx.sessions.create(SessionId('synthetic-child'))
+  return {ctx, fiber, session}
+}
+describe('experimental task title acceptance', () => {
+  it('requires host authority and records task provenance without human messages', async () => {
+    const {ctx,session} = await setup()
+    try {
+      expect(ctx.sessionTitle.submitTaskTitle(session,candidate(1))).toBeUndefined()
+      ctx.provide('taskTitleAuthority', {verify:()=>true})
+      const accepted = ctx.sessionTitle.submitTaskTitle(session,candidate(1))
+      expect(accepted).toMatchObject({title:'Synthetic task',messageSeqs:[],source:{kind:'task',leadId:'lead',taskId:'task',taskRevision:1,taskEventSeq:1}})
+      expect(session.snapshotEvents().some(event=>event.type==='user/message')).toBe(false)
+      expect(ctx.sessionTitle.submitTaskTitle(session,candidate(1,'stale'))).toBeUndefined()
+    } finally { await ctx.fiber.dispose() }
+  })
+  it('honors user pin and an already aborted request', async () => {
+    const {ctx,session} = await setup()
+    try {
+      ctx.provide('taskTitleAuthority',{verify:()=>true})
+      ctx.sessionTitle.rename(session,'User title')
+      expect(ctx.sessionTitle.submitTaskTitle(session,candidate(2))).toBeUndefined()
+      const controller = new AbortController(); controller.abort()
+      expect(()=>ctx.sessionTitle.submitTaskTitle(session,candidate(3),controller.signal)).toThrow()
+      expect(ctx.sessionTitle.get(session)?.title).toBe('User title')
+    } finally { await ctx.fiber.dispose() }
+  })
+  it('supersedes in-flight provider generation without a stale overwrite', async () => {
+    const {ctx,session} = await setup()
+    try {
+      ctx.provide('taskTitleAuthority',{verify:()=>true})
+      session.append('turn/start',{turn:1})
+      session.append('user/message',createUserMessage({content:[{type:'text',text:'human prompt'}],source:{kind:'user'}}),{surfaceOp:'append'})
+      await new Promise(resolve=>setTimeout(resolve,0))
+      const entered=Promise.withResolvers<void>(), release=Promise.withResolvers<void>()
+      ctx.sessionTitle.register({id:SessionTitleProviderId('synthetic'),automatic:'first-prompt',generate:async request=>{
+        entered.resolve(); await release.promise
+        return {title:'Late provider',messageSeqs:request.messages.map(m=>m.seq)}
+      }})
+      const pending=ctx.sessionTitle.refresh(session).catch(()=>undefined)
+      await entered.promise
+      expect(ctx.sessionTitle.submitTaskTitle(session,candidate(2))?.title).toBe('Synthetic task')
+      release.resolve(); await pending
+      expect(ctx.sessionTitle.get(session)?.title).toBe('Synthetic task')
+    } finally { await ctx.fiber.dispose() }
+  })
+  it('folds task provenance and rejects stale cuts after title service restart', async () => {
+    const {ctx,fiber,session} = await setup()
+    try {
+      ctx.provide('taskTitleAuthority',{verify:()=>true})
+      ctx.sessionTitle.submitTaskTitle(session,candidate(3))
+      await fiber.dispose()
+      await ctx.plugin(SessionTitleService,CONFIG)
+      expect(foldSessionTitle(session.snapshotEvents())?.source.kind).toBe('task')
+      expect(ctx.sessionTitle.submitTaskTitle(session,candidate(2,'old'))).toBeUndefined()
+      expect(ctx.sessionTitle.submitTaskTitle(session,candidate(4,'new'))?.title).toBe('new')
+    } finally { await ctx.fiber.dispose() }
+  })
+  it('does not override a pin installed synchronously by a verifier', async () => {
+    const {ctx,session} = await setup()
+    try {
+      let n = 0
+      ctx.provide('taskTitleAuthority',{verify:vi.fn(()=>{if(++n===2) ctx.sessionTitle.rename(session,'Pinned during verify');return true})})
+      expect(ctx.sessionTitle.submitTaskTitle(session,candidate(1))).toBeUndefined()
+      expect(ctx.sessionTitle.get(session)?.title).toBe('Pinned during verify')
+    } finally { await ctx.fiber.dispose() }
+  })
+  it('rejects proxy and accessor candidates without invoking them', async () => {
+    const {ctx,session} = await setup()
+    try {
+      const verify = vi.fn(()=>true); ctx.provide('taskTitleAuthority',{verify})
+      let calls=0
+      const poisoned = Object.defineProperty(candidate(1),'title',{get(){calls++;throw Error('getter')}})
+      const proxy = new Proxy(candidate(1),{getPrototypeOf(){calls++;throw Error('trap')}})
+      const revoked = Proxy.revocable(candidate(1),{}); revoked.revoke()
+      for(const input of [poisoned,proxy,revoked.proxy]) expect(()=>ctx.sessionTitle.submitTaskTitle(session,input)).toThrow(/invalid task title candidate/)
+      expect(calls).toBe(0); expect(verify).not.toHaveBeenCalled()
+      expect(ctx.sessionTitle.get(session)).toBeUndefined()
+    } finally { await ctx.fiber.dispose() }
+  })
+  it('demonstrates released JSONL reader rejects the experimental task source', async () => {
+    const root = await mkdtemp(join(tmpdir(),'task-title-wip-'))
+    const ctx = new Context()
+    try {
+      await ctx.plugin(SessionStore); await ctx.plugin(SessionProjectionRegistry)
+      await ctx.plugin(JsonlSessionPersistence,{root,compression:'none'})
+      await ctx.plugin(SessionTitleService,CONFIG)
+      ctx.provide('taskTitleAuthority',{verify:()=>true})
+      const id=SessionId('synthetic-persisted-title'), session=ctx.sessions.create(id)
+      const handle=await ctx.sessionPersistence.create(session.header)
+      ctx.sessionTitle.submitTaskTitle(session,candidate(3))
+      await handle.close()
+      await expect(ctx.sessionPersistence.open(id,'read')).rejects.toThrow(/messageSeqs must be empty exactly for a user title/)
+    } finally { await ctx.fiber.dispose(); await rm(root,{recursive:true,force:true}) }
+  })
+  it('preserves an ignorable plugin suggestion while released canonical title stays pinned', async () => {
+    const root=await mkdtemp(join(tmpdir(),'task-title-overlay-'))
+    const ctx=new Context()
+    try {
+      await ctx.plugin(SessionStore); await ctx.plugin(SessionProjectionRegistry)
+      await ctx.plugin(JsonlSessionPersistence,{root,compression:'none'}); await ctx.plugin(SessionTitleService,CONFIG)
+      const id=SessionId('synthetic-overlay'), session=ctx.sessions.create(id)
+      const handle=await ctx.sessionPersistence.create(session.header)
+      ctx.sessionTitle.rename(session,'Pinned human title')
+      appendPluginRecord(session,'plugin:test-task-title',{version:1,title:'Synthetic suggestion'})
+      await handle.close()
+      const reader=await ctx.sessionPersistence.open(id,'read')
+      try {
+        const events=(await reader.read()).events
+        expect(foldSessionTitle(events)).toMatchObject({title:'Pinned human title',source:{kind:'user'}})
+        expect(events.map(pluginRecordOf).find(x=>x?.type==='plugin:test-task-title')?.data).toEqual({version:1,title:'Synthetic suggestion'})
+      } finally { await reader.close() }
+    } finally { await ctx.fiber.dispose(); await rm(root,{recursive:true,force:true}) }
+  })
+})
