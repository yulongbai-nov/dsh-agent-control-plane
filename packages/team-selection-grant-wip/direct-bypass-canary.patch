new file mode 100644
index 00000000..9f59d831
--- /dev/null
+++ b/packages/experimental/agent-team/tests/direct-selection-bypass-wip.spec.ts
@@ -0,0 +1,70 @@
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import SubagentService from '@deepseek-ai/dsh-subagent'
+import * as SubagentSpawn from '@deepseek-ai/dsh-subagent-spawn-in-process'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { expect, it } from 'vitest'
+import { MockAdapter } from '../../../core/agent-loop/tests/mock-adapter.ts'
+import { mountWorkingDirectoryFixture } from '../../../subagent/subagent/tests/working-directory-fixture.ts'
+import TeamService from '../src/index.ts'
+import { TeamSelectionAuthority } from '../src/selection-authority-wip.ts'
+import { TestSessionQuery } from './test-session-query.ts'
+
+async function fixture() {
+  const root=mkdtempSync(join(tmpdir(),'team-direct-bypass-')),ctx=new Context()
+  await mountAgentLoopTestDependencies(ctx);await mountWorkingDirectoryFixture(ctx)
+  await ctx.plugin(JsonlSessionPersistence,{root});await ctx.plugin(TestSessionQuery)
+  await ctx.plugin(AgentLoop,{agents:[]});await ctx.plugin(SubagentService)
+  await ctx.plugin(SubagentSpawn,{providerName:'spawn'});await ctx.plugin(TeamService)
+  ctx.provide('teamSelectionAuthority',new TeamSelectionAuthority(ctx)) // no Team grant
+  ctx.llm.registerAdapter(['mock'],new MockAdapter(['hang']))
+  const lead=await ctx.agentLoop.create(SessionId('synthetic-direct-lead'),{provider:'mock',model:'mock'})
+  return {ctx,lead,close:async()=>{await ctx.fiber.dispose();rmSync(root,{recursive:true,force:true})}}
+}
+const content=[{type:'text' as const,text:'synthetic'}]
+
+it('documents direct native activation bypassing absent Team grant',async()=>{
+  const {ctx,lead,close}=await fixture();const signal=new AbortController().signal
+  try {
+    await expect(ctx.agentTeams.spawnTeammate(lead,{name:'worker',description:'synthetic',prompt:content,context:'fresh',provider:'spawn',signal,agentOptions:{provider:'mock',model:'member-model'}})).rejects.toMatchObject({code:'TEAM_SELECTION_UNAUTHORIZED'})
+    const run=await ctx.subagents.startActivation({provider:'spawn',label:'synthetic',delivery:'parent',signal,request:{parent:lead,prompt:content,agentOptions:{provider:'mock',model:'member-model'}}})
+    expect(ctx.agents.get(run.childId)?.options.model).toBe('member-model')
+    await run.dispose()
+  } finally {await close()}
+})
+
+it.fails('desired central contract rejects direct activation without a Team permit',async()=>{
+  const {ctx,lead,close}=await fixture();const signal=new AbortController().signal
+  try {
+    await expect(ctx.subagents.startActivation({provider:'spawn',label:'synthetic',delivery:'parent',signal,request:{parent:lead,prompt:content,agentOptions:{provider:'mock',model:'member-model'}}})).rejects.toThrow()
+  } finally {await close()}
+})
+
+it('a fresh in-memory authority has no restored grant',async()=>{
+  const {ctx,lead,close}=await fixture()
+  try {
+    ctx.teamSelectionAuthority.grant(lead,{version:1,routes:[{provider:'mock',model:'member-model'}]})
+    expect(()=>ctx.teamSelectionAuthority.authorize(lead,{provider:'mock',model:'member-model'})).not.toThrow()
+    const replacement=new TeamSelectionAuthority(ctx)
+    expect(()=>replacement.authorize(lead,{provider:'mock',model:'member-model'})).toThrow(/unauthorized/)
+  } finally {await close()}
+})
+
+it('documents that ordinary roots are already implicit Team leads without Team identity records',async()=>{
+  const {ctx,lead,close}=await fixture()
+  try {
+    const ordinary=await ctx.agentLoop.create(SessionId('ordinary-independent-root'),{provider:'mock',model:'mock'})
+    expect(ctx.agentTeams.membership(lead).role).toBe('lead')
+    expect(ctx.agentTeams.membership(ordinary).role).toBe('lead')
+    for(const agent of [lead,ordinary]) {
+      expect(agent.session.header.parentSession).toBeUndefined()
+      expect(agent.session.header.origin).toBeUndefined()
+      expect(agent.session.snapshotEvents().some(event=>event.type==='team/member')).toBe(false)
+    }
+  } finally {await close()}
+})
