diff --git a/packages/experimental/agent-team/src/selection-authority-wip.ts b/packages/experimental/agent-team/src/selection-authority-wip.ts
new file mode 100644
index 00000000..3848d597
--- /dev/null
+++ b/packages/experimental/agent-team/src/selection-authority-wip.ts
@@ -0,0 +1,37 @@
+/** Experimental in-memory Host grant; not a durable, authenticated policy service. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent, AgentOptions } from '@deepseek-ai/dsh-agent'
+import type { Session } from '@deepseek-ai/dsh-session'
+
+declare module '@deepseek-ai/cordis' { interface Context { teamSelectionAuthority: TeamSelectionAuthority } }
+type Grant = { readonly version: 1; readonly routes: readonly { readonly provider: string; readonly model: string }[]; readonly maxTokens?: number }
+type Entry = { readonly epoch: number; readonly grant: Grant }
+export interface TeamSelectionPermit { readonly session: Session; readonly entry: Entry }
+
+/** Only trusted Host test code can configure this prototype; no persistence or RPC is provided. */
+export class TeamSelectionAuthority {
+  private readonly grants = new WeakMap<Session, Entry>()
+  private epoch = 0
+  constructor(private readonly ctx: Context) {}
+  grant(root: Agent, input: Grant): void {
+    if (this.ctx.agents.get(root.id) !== root || this.ctx.sessions.get(root.id) !== root.session) throw new Error('grant target is not live')
+    if (input.version !== 1 || !Array.isArray(input.routes) || input.routes.length === 0 || input.routes.length > 100 ||
+      input.routes.some(route => typeof route.provider !== 'string' || !route.provider || typeof route.model !== 'string' || !route.model) ||
+      (input.maxTokens !== undefined && (!Number.isSafeInteger(input.maxTokens) || input.maxTokens <= 0))) throw new Error('invalid selection grant')
+    const grant = Object.freeze({ version: 1 as const, routes: Object.freeze(input.routes.map(route => Object.freeze({provider:route.provider,model:route.model}))),
+      ...(input.maxTokens === undefined ? {} : {maxTokens:input.maxTokens}) })
+    this.grants.set(root.session,{epoch:++this.epoch,grant})
+  }
+  revoke(root: Agent): void { this.grants.delete(root.session); this.epoch++ }
+  authorize(root: Agent, options: AgentOptions): TeamSelectionPermit {
+    const entry=this.grants.get(root.session)
+    if (!entry || this.ctx.agents.get(root.id)!==root || this.ctx.sessions.get(root.id)!==root.session ||
+      !options.provider || !options.model || !entry.grant.routes.some(route=>route.provider===options.provider && route.model===options.model) ||
+      (options.maxTokens !== undefined && (entry.grant.maxTokens === undefined || options.maxTokens > entry.grant.maxTokens))) throw new Error('Team member selection unauthorized')
+    return Object.freeze({session:root.session,entry})
+  }
+  valid(root: Agent, permit: TeamSelectionPermit): boolean {
+    return this.ctx.agents.get(root.id)===root && this.ctx.sessions.get(root.id)===root.session &&
+      permit.session===root.session && this.grants.get(root.session)===permit.entry
+  }
+}
