+/** Snapshot a deliberately closed subset before asynchronous admission. */
+function memberSelection(options: SpawnTeammateRequest['agentOptions'], preset: unknown): Pick<SpawnTeammateRequest, 'agentOptions' | 'agentPreset'> {
+  if (preset !== undefined && (typeof preset !== 'string' || !preset.trim() || preset.length > 200)) {
+    throw new TeamError('invalid independent preset', 'TEAM_INVALID_REQUEST')
+  }
+  if (options === undefined) return preset === undefined ? {} : { agentPreset: preset as string }
+  if (options === null || typeof options !== 'object' || nodeTypes.isProxy(options) || ![Object.prototype, null].includes(Object.getPrototypeOf(options)) || Object.getOwnPropertySymbols(options).length) {
+    throw new TeamError('invalid agent options', 'TEAM_INVALID_REQUEST')
+  }
+  const fields = Object.getOwnPropertyDescriptors(options)
+  const output: Record<string, string | number> = {}
+  for (const [key, descriptor] of Object.entries(fields)) {
+    if (!['provider', 'model', 'reasoningEffort', 'maxTokens'].includes(key) || !('value' in descriptor)) {
+      throw new TeamError('unsupported agent option', 'TEAM_INVALID_REQUEST')
+    }
+    const value: unknown = descriptor.value
+    if (key === 'maxTokens' ? !Number.isSafeInteger(value) || (value as number) <= 0 : typeof value !== 'string' || !value.trim() || value.length > 200) {
+      throw new TeamError('invalid agent option value', 'TEAM_INVALID_REQUEST')
+    }
+    output[key] = value as string | number
+  }
+  return { agentOptions: output as NonNullable<SpawnTeammateRequest['agentOptions']>, ...(preset === undefined ? {} : { agentPreset: preset as string }) }
+}
+
+/** Reject proxy/accessor request envelopes before reading any field. */
+function snapshotSpawnRequest(input: SpawnTeammateRequest): SpawnTeammateRequest {
+  if (input === null || typeof input !== 'object' || nodeTypes.isProxy(input) || ![Object.prototype, null].includes(Object.getPrototypeOf(input)) || Object.getOwnPropertySymbols(input).length) {
+    throw new TeamError('invalid spawn request', 'TEAM_INVALID_REQUEST')
+  }
+  const required = ['name', 'description', 'prompt', 'context', 'provider', 'signal']
+  const allowed = new Set([...required, 'agentOptions', 'agentPreset'])
+  const fields = Object.getOwnPropertyDescriptors(input)
+  const snapshot: Record<string, unknown> = Object.create(null)
+  for (const [key, descriptor] of Object.entries(fields)) {
+    if (!allowed.has(key) || !('value' in descriptor)) throw new TeamError('invalid spawn request field', 'TEAM_INVALID_REQUEST')
+    snapshot[key] = descriptor.value
+  }
+  if (required.some(key => !Object.hasOwn(snapshot, key))) throw new TeamError('missing spawn request field', 'TEAM_INVALID_REQUEST')
+  return snapshot as unknown as SpawnTeammateRequest
+}
+
