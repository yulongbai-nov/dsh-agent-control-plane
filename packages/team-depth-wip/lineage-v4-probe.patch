+++ b/packages/session/session-persistence-jsonl/tests/team-lineage-v4-probe.spec.ts
@@ -0,0 +1,26 @@
+import { Context } from '@deepseek-ai/cordis'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import { mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { dirname, join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { expect, it } from 'vitest'
+import { generationLogPath } from '../src/format.ts'
+
+it('released V4 reader refuses a synthetic unknown required Team identity event without file mutation', async () => {
+  const root=await mkdtemp(join(tmpdir(),'synthetic-team-lineage-'))
+  const ctx=new Context()
+  try {
+    await ctx.plugin(JsonlSessionPersistence,{root,compression:'none'})
+    const id=SessionId('synthetic-team-node'), path=generationLogPath(root,'/synthetic',id,4,'none')
+    await mkdir(dirname(path),{recursive:true})
+    const header={type:'session',version:4,id,createdAt:1,cwd:'/synthetic',delegationDepth:0,isSeeded:false}
+    const event={type:'team/node-identity',seq:0,time:2,data:{version:1,team:'synthetic'}}
+    const bytes=Buffer.from(`${JSON.stringify(header)}\n${JSON.stringify(event)}\n`)
+    await writeFile(path,bytes)
+    for(const mode of ['read','write'] as const) {
+      await expect(ctx.sessionPersistence.open(id,mode)).rejects.toMatchObject({name:'SessionFormatUnsupportedError'})
+      expect(await readFile(path)).toEqual(bytes)
+    }
+  } finally { await ctx.fiber.dispose(); await rm(root,{recursive:true,force:true}) }
+})
