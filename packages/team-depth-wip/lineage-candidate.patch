@@ -0,0 +1,26 @@
+import { describe, expect, it } from 'vitest'
+import { inspectLineageCandidate } from '../src/lineage-candidate.ts'
+
+const node = (nodeId: string, parentId: string | null, level: number, extra = {}) => ({version:1,nodeId,rootId:'root',parentId,level,override:null,policyRevision:1,...extra})
+describe('untrusted lineage candidate shape', () => {
+  it('can validate root plus three levels but never authorizes it', () => {
+    expect(inspectLineageCandidate([node('root',null,0),node('a','root',1),node('b','a',2),node('c','b',3)]).status).toBe('UNVERIFIED')
+  })
+  it('rejects fourth levels, missing parents, duplicate nodes, mismatched roots and invalid policy revisions', () => {
+    const root=node('root',null,0), a=node('a','root',1), b=node('b','a',2), c=node('c','b',3)
+    for (const value of [[root,a,b,c,node('d','c',4)], [root,node('x','missing',1)], [root,a,a], [root,node('x','root',1,{rootId:'other'})], [root,node('x','root',1,{policyRevision:0})], [root,node('x','root',1,{override:4})]]) {
+      expect(inspectLineageCandidate(value).status).toBe('INVALID')
+    }
+  })
+  it('rejects accessors, proxies and revoked proxies without invoking their traps', () => {
+    let calls=0
+    const accessor=Object.defineProperty(node('root',null,0),'nodeId',{get(){calls++;throw Error('getter')}})
+    const proxy=new Proxy(node('root',null,0),{ownKeys(){calls++;throw Error('trap')}})
+    const revoked=Proxy.revocable(node('root',null,0),{});revoked.revoke()
+    for(const value of [accessor,proxy,revoked.proxy]) expect(inspectLineageCandidate([value]).status).toBe('INVALID')
+    const array=[node('root',null,0)]
+    Object.defineProperty(array,'0',{get(){calls++;throw Error('array getter')}})
+    expect(inspectLineageCandidate(array).status).toBe('INVALID')
+    expect(calls).toBe(0)
+  })
+})
