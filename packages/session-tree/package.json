{
  "name": "dsh-session-tree",
  "version": "0.1.0",
  "description": "Independent session lineage browser for DeepSeek Harness rc.5",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "client.template.js", "build.mjs", "cordis.patch.yml", "avatars", "test", "README.md"],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs --check && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.1-rc.5"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
