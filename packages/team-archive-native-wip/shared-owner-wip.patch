@@ -0,0 +1,22 @@
+/** Synthetic subprocess: only reads/writes the caller-supplied temporary root. */
+import { Context } from '@deepseek-ai/cordis'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import Storage from '../../../storage/storage/src/index.ts'
+import { DomainFacility } from '../../../storage/storage-domain/src/index.ts'
+import { JsonStorageBackend } from '../../../storage/storage-json/src/index.ts'
+import WorkspaceRegistry from '../../../workspace/workspace/src/index.ts'
+
+const [root,mode]=process.argv.slice(2)
+if (!root || !['write','read'].includes(mode ?? '')) throw new Error('invalid synthetic fixture arguments')
+const ctx=new Context()
+try {
+  await ctx.plugin(SessionStore)
+  const target=ctx.sessions.create(SessionId('synthetic-process-target'))
+  ctx.provide('sessionPersistence',{list:async()=>[]} as never)
+  await ctx.plugin(Storage)
+  const backend=new JsonStorageBackend(root);ctx.storage.backend.register('json',backend)
+  const domain=new DomainFacility(ctx,{backend:'json',routes:{}});ctx.storage.mount('domain',domain);ctx.provide('storageDomain',domain)
+  await ctx.plugin(WorkspaceRegistry)
+  if(mode==='write') await ctx.workspaceRegistry.archiveSession(target.id)
+  else if(!ctx.workspaceRegistry.archivedSessionIds.includes(target.id)) throw new Error('archive not restored')
+} finally {await ctx.fiber.dispose()}
