diff --git a/packages/workspace/workspace/src/index.ts b/packages/workspace/workspace/src/index.ts
index 0f630500..5fd082d0 100644
--- a/packages/workspace/workspace/src/index.ts
+++ b/packages/workspace/workspace/src/index.ts
@@ -347,0 +348,18 @@ export class WorkspaceRegistry extends Service {
+  /** Experimental same-registry admission: not cross-process safe. */
+  withDeliveryAdmission<T>(sessionId: SessionId, operation: () => Promise<T>): Promise<T> {
+    return this.enqueueOperation(async () => {
+      let id = sessionId
+      const visited = new Set<SessionId>()
+      while (true) {
+        if (visited.has(id)) throw new Error('archive admission: ambiguous cyclic lineage')
+        visited.add(id)
+        if (this.requireState().archivedSessionIds.includes(id)) throw new Error('archive admission: session is archived')
+        const header = await this.readSessionHeader(id)
+        if (header.origin !== 'subagent') break
+        if (header.parentSession === undefined) throw new Error('archive admission: missing subagent parent')
+        id = header.parentSession
+      }
+      return await operation()
+    })
+  }
+
diff --git a/packages/experimental/agent-team/tests/archive-bypass-wip.spec.ts b/packages/experimental/agent-team/tests/archive-bypass-wip.spec.ts
